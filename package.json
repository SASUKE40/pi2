{
  "name": "pi2",
  "version": "0.1.0",
  "private": true,
  "description": "Harness2 refinement, domain learning and official benchmark workflows on Pi Durable",
  "type": "module",
  "bin": {
    "pi2": "dist/cli.js"
  },
  "engines": {
